embed
  {{ tex-preamble
    \newcommand{\mt}{ \raisebox{1ex-0.5\height}{$\centerdot$} }
    \newcommand{\const}[1]{ \mathsf{#1} }
  }}

metavar tmvar, x, y, z, f, g, s ::=
  {{ repr-locally-nameless }}
  {{ com variables }}
  {{ lex alphanum }}

metavar m, n ::=
  {{ coq nat }}

indexvar idx ::=
  {{ coq nat }}
  {{ tex \mathit{i} }}

%%%%%%%%%%%%%%%
%%  Grammar  %%
%%%%%%%%%%%%%%%

grammar

luniv, i, j :: 'u_' ::=
  {{ com universe levels }}
  {{ coq-universe Type }}
  | n :: :: Level
    {{ tex [[n]] }}
  | i + 1 :: :: Succ
    {{ tex [[i]] + 1 }}
  | max i j :: :: Max
    {{ tex [[i]] \vee [[j]] }}
  | ( i ) :: S :: Parens
    {{ coq ([[i]]) }}
    {{ tex ([[i]]) }}
  | (# i #) :: S :: SecretParens
    {{ coq ([[i]]) }}
    {{ tex [[i]] }}

grade, k, l {{ tex \ell }} :: 'l_' ::=
  {{ com grades/levels }}
  {{ coq-universe Type }}
  | n :: :: Level
    {{ tex [[n]] }}
  | k /\ l :: :: Meet
    {{ tex [[k]] \wedge [[l]] }}
  | ( l ) :: S :: Parens
    {{ coq ([[l]]) }}
    {{ tex ([[l]]) }}
  | (# l #) :: S :: SecretParens
    {{ coq ([[l]]) }}
    {{ tex [[l]] }}

tm, a, b, c, A, B, C, p :: 'a_' ::=
  {{ com terms and types }}
  {{ coq-universe Type }}
  | x :: :: Var
    {{ com variables }}
    {{ tex [[x]] }}
  | Pi x : l A . B :: :: Pi
    (+ bind x in B +)
    {{ com dependent function type }}
    {{ tex \Pi [[x]] :^{[[l]]} \! [[A]] \mathpunct{.} [[B]] }}
  | \ l x . b :: :: Abs
    (+ bind x in b +)
    {{ com function abstraction }}
    {{ tex \lambda [[x]]^{[[l]]} \mathpunct{.} [[b]]}}
  | b l a :: :: App
    {{ com function application }}
    {{ tex [[b]] \, [[a]]^{[[l]]} }}
  | Univ i :: :: Univ
    {{ com type universe }}
    {{ tex \mathcal{U}_{[[i]]} }} % or perhaps \star_{[[i]]}
  | Void :: :: Empty
    {{ com empty type }}
    {{ tex \bot }}
  | absurd b :: :: Absurd
    {{ com ex falso quodlibet }}
    {{ tex \ottkw{absurd} \, [[b]] }}
  | a ~ l b : A :: :: Eq
    {{ com indistinguishability }}
    {{ tex [[a]] \sim^{[[l]]} \! [[b]] \in [[A]] }}
  | refl :: :: Refl
    {{ com reflexivity }}
    {{ tex \ottkw{refl} }}
  | J c p :: :: J
    {{ com eliminator for equality }}
    {{ tex \ottkw{J} \, [[c]] \, [[p]] }}
  | Sig x : l A . B :: :: Sig
    (+ bind x in B +)
    {{ com dependent pair type }}
    {{ tex \Sigma [[x]] :^{[[l]]} \! A \mathpunct{.} [[B]] }}
  | ( l a , b ) :: :: Pack
    {{ com pair constructor }}
    {{ tex ([[a]]^{[[l]]}, [[b]]) }}
  | let ( l x , y ) = k a in b :: :: Let
    (+ bind x union y in b +)
    {{ com weak pair projection }}
    {{ tex \ottkw{let} \, ([[x]]^{[[l]]}, [[y]]) = [[a]]^{[[k]]} \mathrel{ \ottkw{in} } [[b]] }}
  | T l A :: S :: T
    {{ com boxed type }}
    {{ coq }}
    {{ tex \ottkw{T}^{[[l]]} \, [[A]] }}
  | box l a :: S :: box
    {{ com box }}
    {{ coq }}
    {{ tex \ottkw{box}^{[[l]]} \, [[a]] }}
  | unbox l a :: S :: unbox
    {{ com unbox }}
    {{ coq }}
    {{ tex \ottkw{unbox}^{[[l]]} [[a]] }}
  | ( a ) :: S :: Parens
    {{ com parentheses }}
    {{ coq ([[a]]) }}
    {{ tex ([[a]]) }}
  | (# a #) :: S :: SecretParens
    {{ com invisible parentheses }}
    {{ coq ([[a]]) }}
    {{ tex [[a]] }}
  | a { b / x } :: S :: Subst
    {{ com single substitution }}
    {{ coq (open_tm_wrt_tm [[x]] [[a]] [[b]]) }}
    {{ tex [[a]] \lbrack [[b]] / [[x]] \rbrack }}
  | a { b / x , c / y } :: S :: Subst2
    {{ com double substitution }}
    {{ coq (open_tm_wrt_tm [[y]] (open_tm_wrt_tm [[x]] [[a]] [[b]]) [[c]]) }}
    {{ tex [[a]] \lbrack [[b]] / [[x]], [[c]] / [[y]] \rbrack }}

context, G {{ tex \Gamma }}, D {{ tex \Delta }} :: 'ctx_' ::=
  {{ com contexts }}
  {{ coq list (atom * (grade * tm)) }}
  {{ coq-universe Type }}
  | nil :: S :: Nil
    {{ com empty context }}
    {{ coq nil }}
    {{ tex \mt }}
  | x : l A :: S :: One
    {{ com singleton context }}
    {{ coq ([[x]], ([[l]], [[A]])) }}
    {{ tex [[x]] :^{[[l]]} \! [[A]] }}
  | G ++ G' :: S :: Append
    {{ com appending two contexts }}
    {{ coq [[G]] ++ [[G']] }}
    {{ tex [[G]], [[G']] }}
  | ( G ) :: S :: Parens
    {{ com parentheses }}
    {{ coq ([[G]]) }}
    {{ tex ([[G]]) }}
  | (# G #) :: S :: SecretParens
    {{ com invisible parentheses }}
    {{ coq ([[G]]) }}
    {{ tex [[G]] }}

econtext, E {{ tex \Xi }} :: 'ectx_' ::=
  {{ com erased contexts }}
  {{ coq list ( atom * grade ) }}
  {{ coq-universe Type }}
  | empty :: S :: Empty
    {{ com empty context }}
    {{ coq nil }}
    {{ tex \mt }}
  | x : l :: S :: One
    {{ com singleton context }}
    {{ coq ([[x]], [[l]]) }}
    {{ tex [[x]] : [[l]] }}
  | E ++ E' :: S :: Append
    {{ com appending two contexts }}
    {{ coq [[E]] ++ [[E']] }}
    {{ tex [[E]], [[E']] }}
  | | G | :: S :: Erase
    {{ com erased contexts }}
    {{ coq c2e [[G]] }}
    {{ tex \lvert [[G]] \rvert }}
  | ( E ) :: S :: Parens
    {{ com parentheses }}
    {{ coq ([[E]]) }}
    {{ tex ([[E]]) }}
  | (# E #) :: S :: SecretParens
    {{ com invisible parentheses }}
    {{ coq ([[E]]) }}
    {{ tex [[E]] }}

substitutions
  single tm x :: subst
  multiple tm x :: substs

freevars
  tm x :: fv

%%%%%%%%%%%%%%%%
%%  Formulas  %%
%%%%%%%%%%%%%%%%

grammar

formula :: 'formula_' ::=
  | judgement :: :: judgement % DON'T DELETE THIS
  | formula1 .. formulaidx :: :: dots % DON'T DELETE THIS
  | x : l A in G :: :: inG
    {{ coq binds [[x]] ([[l]], [[A]]) [[G]] }}
    {{ tex [[x]] :^{[[l]]} \! [[A]] \in [[G]] }}
  | x : l in E :: :: inE
    {{ coq binds [[x]] [[l]] [[E]] }}
    {{ tex [[x]] : [[l]] \in [[E]] }}
  | x notin G :: :: notInG
    {{ coq ~ AtomSetImpl.In [[x]] (dom [[G]]) }}
    {{ tex [[x]] \notin [[G]] }}
  | x notin E :: :: notInE
    {{ coq ~ AtomSetImpl.In [[x]] (dom [[E]]) }}
    {{ tex [[x]] \notin [[E]] }}
  | i <= j :: :: uleq
    {{ coq [[i]] <= [[j]] }}
    {{ tex [[i]] \leq [[j]] }}
  | l1 <= l2 :: :: leq
    {{ coq [[l1]] <= [[l2]] }}
    {{ tex [[l1]] \leq [[l2]] }}
  | not ( l1 <= l2 ) :: S :: not
    {{ coq not ([[l1]] <= [[l2]]) }}
    {{ tex [[l1]] \nleq [[l2]] }}
  | ( formula ) :: S :: Parens
    {{ com parentheses }}
    {{ coq ([[formula]]) }}
    {{ tex ([[formula]]) }}
  | (# formula #) :: S :: SecretParens
    {{ com invisible parentheses }}
    {{ coq ([[formula]]) }}
    {{ tex [[formula]] }}

%%%%%%%%%%%%%%%%%%
%%  Judgements  %%
%%%%%%%%%%%%%%%%%%

%%  Parallel reduction

defns
  Parallel :: '' ::=

defn
  a => b :: :: Par :: 'P_'
  {{ com parallel reduction }}
  {{ tex [[a]] \Rightarrow [[b]] }}
by

% beta rules

a0 => a1
b0 => b1
------------------------------------ :: AppAbs
(\ l0 x . b0) l0 a0 => b1 { a1 / x }

t0 => t1
----------------- :: JRefl
J t0 refl => t1

a0 => a1
b0 => b1
c0 => c1
---------------------------------------------------------------- :: LetPack
let (l0 x, y) = l1 (l0 a0, b0) in c0 => c1 { a1 / x , b1 / y }

% congruence rules

------ :: Var
x => x

A0 => A1
B0 => B1
-------------------------------------- :: Pi
Pi x : l0 A0 . B0 => Pi x : l0 A1 . B1

b0 => b1
-------------------------- :: Abs
\ l0 x . b0 => \ l0 x . b1

b0 => b1
a0 => a1
-------------------- :: App
b0 l0 a0 => b1 l0 a1

---------------- :: Univ
Univ i => Univ i

------------ :: Empty
Void => Void

b0 => b1
---------------------- :: Absurd
absurd b0 => absurd b1

a0 => a1
b0 => b1
A0 => A1
---------------------------------- :: Eq
a0 ~ l0 b0 : A0 => a1 ~ l0 b1 : A1

------------ :: Refl
refl => refl

p0 => p1
c0 => c1
------------------------ :: J
J c0 p0 => J c1 p1

A0 => A1
B0 => B1
---------------------------------------- :: Sig
Sig x : l0 A0 . B0 => Sig x : l0 A1 . B1

a0 => a1
b0 => b1
-------------------------- :: Pack
(l0 a0, b0) => (l0 a1, b1)

a0 => a1
b0 => b1
---------------------------------------------------------- :: Let
let (l0 x, y) = l1 a0 in b0 => let (l0 x, y) = l1 a1 in b1

defns
  Parallels :: '' ::=

defn
  a =>* b :: :: Pars :: 'Ps_'
  {{ com multi-step parallel reduction }}
  {{ tex [[a]] \Rightarrow^{\ast} [[b]] }}
by

a => b
------- :: Refl
a =>* b

a => b
b =>* c
------- :: Trans
a =>* c

%% Indistinguishability

defns
  Indist :: '' ::=

defn
  E |- a == b @ l :: :: IEq :: 'I_'
  {{ com indistinguishability }}
  {{ tex [[E]] \vdash [[a]] \equiv^{[[l]]} [[b]] }}
by

x : l0 in E
l0 <= l
--------------- :: Var
E |- x == x @ l

E |- A0 == A1 @ l
E ++ x : l0 |- B0 == B1 @ l
--------------------------------------------- :: Pi
E |- Pi x : l0 A . B == Pi x : l0 A1 . B1 @ l

E ++ x : l0 |- b0 == b1 @ l
----------------------------------- :: Abs
E |- \ l0 x . b0 == \ l0 x . b1 @ l

E |- b0 == b1 @ l
E |- a0 == a1 @ l l0
----------------------------- :: App
E |- b0 l0 a0 == b1 l0 a1 @ l

------------------------- :: Univ
E |- Univ i == Univ i @ l

--------------------- :: Empty
E |- Void == Void @ l

------------------------------- :: Absurd
E |- absurd b0 == absurd b1 @ l

E |- a0 == a1 @ l
E |- b0 == b1 @ l
l0 <= l
------------------------------------------- :: Eq
E |- a0 ~ l0 b0 : A0 == a1 ~ l0 b1 : A1 @ l

--------------------- :: Refl
E |- refl == refl @ l

E |- p0 == p1 @ l
E |- c0 == c1 @ l
--------------------------------- :: J
E |- J c0 p0 == J c1 p1 @ l

E |- A0 == A1 @ l
E ++ x : l0 |- B0 == B1 @ l
----------------------------------------------- :: Sig
E |- Sig x : l0 A0 . B0 == Sig x : l0 A1 . B1 @ l

E |- a0 == a1 @ l l0
E |- b0 == b1 @ l
----------------------------------- :: Pack
E |- (l0 a0, b0) == (l0 a1, b1) @ l

E |- a0 == a1 @ l
(# E ++ x : l0 #) ++ y : l1 |- b0 == b1 @ l
------------------------------------------------------------------- :: Let
E |- let (l0 x, y) = l1 a0 in b0 == let (l0 x, y) = l1 a1 in b1 @ l

defn
  E |- a == b @ l l0 :: :: GIEq :: 'GI_'
  {{ com guarded indistinguishability }}
  {{ tex [[E]] \vdash [[a]] \equiv^{[[l]]}_{[[l0]]} [[b]] }}
by

E |- a == b @ l
l0 <= l
------------------ :: Dist
E |- a == b @ l l0

not (l0 <= l)
------------------ :: Indist
E |- a == b @ l l0

defns
  DefEq :: '' ::=

defn
  E |- a == b :: :: DefEq :: 'E_'
  {{ com definitional equality }}
  {{ tex [[E]] \vdash [[a]] \equiv [[b]] }}
by

a =>* c0
b =>* c1
E |- c0 == c1 @ l
----------------- :: Conv
E |- a == b

%% Typing and grading judgements

defns
  Typing :: '' ::=

defn
  |- G :: :: Wf :: 'Wf_'
  {{ com well-formedness }}
  {{ tex \vdash [[G]] }}
by

------ :: Nil
|- nil

|- G
G |- A : l Univ i
----------------- :: Cons
|- G ++ x : l A

defn
  G |- a : A :: :: Wtg :: 'Wtg_'
  {{ com ungraded well-typedness }}
  {{ tex [[G]] \vdash [[a]] : [[A]] }}
by

G |- a : l A
------------ :: Grade
G |- a : A

defn
  G |- a : l A :: :: Wt :: 'Wt_'
  {{ com well-typedness }}
  {{ tex [[G]] \vdash [[a]] :^{[[l]]} [[A]] }}
by

|- G
x : l0 A in G
l0 <= l
------------- :: Var
G |- x : l A

G |- A : l Univ i
G ++ x : l0 A |- B : l Univ j
------------------------------------------- :: Pi
G |- Pi x : l0 A . B : l Univ (# max i j #)

G ++ x : l0 A |- b : l B
G |- Pi x : l0 A . B : Univ i
----------------------------------- :: Abs
G |- \ l0 x . b : l Pi x : l0 A . B

G |- b : l Pi x : l0 A . B
G |- a : l0 A
--------------------------- :: App
G |- b l0 a : l B { a / x }

|- G
-------------------------------- :: Univ
G |- Univ i : l Univ (# i + 1 #)

|- G
-------------------- :: Empty
G |- Void : l Univ i

G |- b : Void
G |- A : Univ i
------------------- :: Absurd
G |- absurd b : l A

G |- A : Univ i
G |- a : l0 A
G |- b : l0 A
l0 <= l
---------------------------- :: Eq
G |- a ~ l0 b : A : l Univ j

G |- a : l0 A
-------------------------- :: Refl
G |- refl : l a ~ l0 a : A

G |- a : l1 A
G |- b : l1 A
G |- A : Univ i
G |- p : l2 a ~ l0 b : A
(# G ++ x : l1 A #) ++ y : l2 a ~ l0 x : A |- C : l0 Univ j
G |- c : l C { a / x , refl / y }
l1 <= l0
l2 <= l
----------------------------------------------------------- :: J
G |- J c p : l C { b / x , p / y }

G |- A : l Univ i
G ++ x : l0 A |- B : l Univ j
-------------------------------------------- :: Sig
G |- Sig x : l0 A . B : l Univ (# max i j #)

G |- a : l0 A
G |- b : l B { a / x }
G |- Sig x : l0 A . B : Univ i
----------------------------------- :: Pack
G |- (l0 a, b) : l Sig x : l0 A . B

G |- A : Univ i0
G ++ x : l0 A |- B : Univ i1
G |- a : l1 Sig x : l0 A . B
(# G ++ x : l0 A #) ++ y : l1 B |- b : l C { (l0 x, y) / z }
G ++ z : l1 Sig x : l0 A . B |- C : Univ j
l1 <= l
------------------------------------------------------------ :: Let
G |- let (l0 x, y) = l1 a in b : l C { a / z }

G |- a : l A
G |- B : Univ i
| G | |- A == B
------------------ :: Conv
G |- a : l B

defns
  IOk :: '' ::=

defn
  E |- a : l :: :: Wg :: 'Wg_'
  {{ com well-gradedness }}
  {{ tex [[E]] \vdash [[a]] : [[l]] }}
by

x : l0 in E
l0 <= l
----------- :: Var
E |- x : l

E |- A : l
E ++ x : l0 |- B : l
------------------------ :: Pi
E |- Pi x : l0 A . B : l

E ++ x : l0 |- b : l
-------------------- :: Abs
E |- \ l0 x . b : l

E |- b : l
E |- a : l0
--------------- :: App
E |- b l0 a : l

--------------- :: Univ
E |- Univ i : l

------------- :: Empty
E |- Void : l

E |- b : l0
----------------- :: Absurd
E |- absurd b : l

E |- a : l0
E |- b : l0
l0 <= l
--------------------- :: Eq
E |- a ~ l0 b : A : l

------------- :: Refl
E |- refl : l

E |- p : l0
E |- c : l
l0 <= l
---------------- :: J
E |- J c p : l

E |- A : l
E ++ x : l0 |- B : l
------------------------- :: Sig
E |- Sig x : l0 A . B : l

E |- a : l0
E |- b : l
------------------ :: Pack
E |- (l0 a, b) : l

E |- a : l1
(# E ++ x : l0 #) ++ y : l1 |- b : l
l1 <= l
------------------------------------ :: Let
E |- let (l0 x, y) = l1 a in b : l