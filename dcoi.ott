metavar tmvar, x, y, z, f, g ::=
  {{ repr-locally-nameless }}
  {{ com variables }}
  {{ lex alphanum }}

metavar m, n ::=
  {{ coq nat }}

indexvar idx ::=
  {{ coq nat }}
  {{ tex \mathit{i} }}

%%%%%%%%%%%%%%%
%%  GRAMMAR  %%
%%%%%%%%%%%%%%%

grammar

luniv, i, j :: 'u_' ::=
  {{ coq luniv }}
  | n :: :: Level
    {{ tex [[n]] }}
  | i + 1 :: S :: Succ
    {{ coq S [[i]] }}
    {{ tex [[i]] + 1 }}
  | ( i ) :: S :: Parens
    {{ coq ([[i]]) }}
    {{ tex ([[i]]) }}
  | (# i #) :: S :: SecretParens
    {{ coq ([[i]]) }}
    {{ tex [[i]] }}

grade, k, l {{ tex \ell }} :: 'l_' ::=
  {{ coq grade }}
  | n :: :: Level
    {{ tex [[n]] }}

tm, a, b, c, A, B, C, p, t, u, v :: 'a_' ::=
  {{ com terms and types }}
  {{ coq-universe Type }}
  | x :: :: Var
    {{ com variables }}
    {{ tex [[x]] }}
  | Pi x : l A . B :: :: Pi
    (+ bind x in B +)
    {{ com dependent function type }}
    {{ tex \Pi [[x]] \colon^{[[l]]} [[A]] \mathpunct{.} [[B]] }}
  | \ l x . b :: :: Abs
    (+ bind x in b +)
    {{ com function abstraction }}
    {{ tex \lambda [[x]]^{[[l]]} \mathpunct{.} [[b]]}}
  | b l a :: :: App
    {{ com function application }}
    {{ tex [[b]] \, [[a]]^{[[l]]} }}
  | Univ i :: :: Univ
    {{ com type universe }}
    {{ tex \mathcal{U}_{[[i]]} }} % or perhaps \star_{[[i]]}
  | Void :: :: Void
    {{ com empty type }}
    {{ tex \bot }}
  | absurd b :: :: Absurd
    {{ com ex falso quodlibet }}
    {{ tex \mathop{ \ottkw{absurd} } b }}
  | a ~ l b : A :: :: Eq
    {{ com indistinguishability }}
    {{ tex a \sim^{[[l]]} \! b \in [[A]] }}
  | a ~ l b :: S :: EqS
    {{ com indistinguishability (no type annotation) }}
    {{ coq a_Eq [[a]] [[l]] [[b]] _ }}
    {{ tex a \sim^{[[l]]} \! b }}
  | refl :: :: Refl
    {{ com reflexivity }}
    {{ tex \ottkw{refl} }}
  | J C t p :: :: J
    {{ com eliminator for equality }}
    {{ tex \ottkw{J} \, [[C]] \, [[t]] \, [[p]] }}
  | Sig x : l A . B :: :: Sig
    (+ bind x in B +)
    {{ com dependent pair type }}
    {{ tex \Sigma [[x]] \colon^{[[l]]} A \mathpunct{.} [[B]] }}
  | ( l a , b ) :: :: Pack
    {{ com pair constructor }}
    {{ tex ([[a]]^{[[l]]}, [[b]]) }}
  | let ( l x , y ) = k a in b :: :: Let
    (+ bind x union y in b +)
    {{ com weak pair projection }}
    {{ tex \ottkw{let} \, ([[x]]^{[[l]]}, [[y]]) = [[a]]^{[[k]]} \mathrel{ \ottkw{in} } [[b]] }}
  | T l A :: S :: T
    {{ com boxed type }}
    {{ coq }}
    {{ tex \ottkw{T}^{[[l]]} \, [[A]] }}
  | box l a :: S :: box
    {{ com box }}
    {{ coq }}
    {{ tex \ottkw{box}^{[[l]]} \, [[a]] }}
  | unbox l a :: S :: unbox
    {{ com unbox }}
    {{ coq }}
    {{ tex \ottkw{unbox}^{[[l]]} [[a]] }}
  | ( a ) :: S :: Parens
    {{ com parentheses }}
    {{ coq ([[a]]) }}
    {{ tex ([[a]]) }}
  | (# a #) :: S :: SecretParens
    {{ com invisible parentheses }}
    {{ coq ([[a]]) }}
    {{ tex [[a]] }}
  | a { b / x } :: S :: Subst
    {{ com single substitution }}
    {{ coq (open_tm_wrt_tm [[x a]] [[b]]) }}
    {{ tex [[a]] \lbrack [[x]] \mapsto [[b]] \rbrack }}

context, G {{ tex \Gamma }} :: 'ctx_' ::=
  {{ com contexts }}
  {{ coq list (atom * (grade * tm)) }}
  {{ coq-universe Type }}
  | nil :: S :: Nil
    {{ com empty context }}
    {{ coq nil }}
  | x : l A :: S :: One
    {{ com singleton context }}
    {{ coq ([[x]], ([[l]], [[A]])) }}
    {{ tex [[x]] \colon^{[[l]]} [[A]] }}
  | G ++ G' :: S :: Append
    {{ com appending two contexts }}
    {{ coq [[G]] ++ [[G']] }}
    {{ tex [[G]], [[G']] }}
  | ( G ) :: S :: Parens
    {{ com parentheses }}
    {{ coq ([[G]]) }}
    {{ tex ([[G]]) }}
  | (# G #) :: S :: SecretParens
    {{ com invisible parentheses }}
    {{ coq ([[G]]) }}
    {{ tex [[G]] }}

econtext, E {{ tex \Xi }} :: 'ectx_' ::=
  {{ com erased contexts }}
  {{ coq list ( atom * grade ) }}
  {{ coq-universe Type }}
  | empty :: S :: Empty
    {{ com empty context }}
    {{ coq nil }}
  | x : l :: S :: One
    {{ com singleton context }}
    {{ coq ([[x]], [[l]]) }}
    {{ tex [[x]] \colon [[l]] }}
  | E ++ E' :: S :: Append
    {{ com appending two contexts }}
    {{ coq [[E]] ++ [[E']] }}
    {{ tex [[E]], [[E']] }}
  | | G | :: S :: Erase
    {{ com erased contexts }}
    {{ coq c2e [[G]] }}
    {{ tex \lvert [[G]] \rvert }}
  | ( E ) :: S :: Parens
    {{ com parentheses }}
    {{ coq ([[E]]) }}
    {{ tex ([[E]]) }}
  | (# E #) :: S :: SecretParens
    {{ com invisible parentheses }}
    {{ coq ([[E]]) }}
    {{ tex [[E]] }}

substitutions
  single tm x :: subst
  multiple tm x :: substs

freevars
  tm x :: fv

%%%%%%%%%%%%%%%%
%%  Formulas  %%
%%%%%%%%%%%%%%%%

grammar

formula :: 'formula_' ::=
  | judgement :: :: judgement % DON'T DELETE THIS
  | formula1 .. formulaidx :: :: dots % DON'T DELETE THIS
  | x : l A in G :: :: inG
    {{ coq binds [[x]] ([[l]], [[A]]) [[G]] }}
    {{ tex [[x]] \colon^{[[l]]} \in [[G]] }}
  | x : l in E :: :: inE
    {{ coq binds [[x]] [[l]] [[E]] }}
    {{ tex [[x]] \colon [[l]] \in [[E]] }}
  | x notin G :: :: notInG
    {{ coq ~ AtomSetImpl.In [[x]] (dom [[G]]) }}
    {{ tex [[x]] \notin [[G]] }}
  | x notin E :: :: notInE
    {{ coq ~ AtomSetImpl.In [[x]] (dom [[E]]) }}
    {{ tex [[x]] \notin [[E]] }}
  | l1 <= l2 :: :: leq
    {{ coq [[l1]] <= [[l2]] }}
    {{ tex [[l1]] \leq [[l2]] }}
  | not ( l1 <= l2 ) :: S :: not
    {{ coq not ([[l1]] <= [[l2]]) }}
    {{ tex [[l1]] \nleq [[l2]] }}

%%%%%%%%%%%%%%%%%%
%%  Judgements  %%
%%%%%%%%%%%%%%%%%%

%%  Parallel reduction

defns
  Parallel :: '' ::=

defn
  a => b :: :: Par :: 'P_'
  {{ com parallel reduction }}
  {{ tex [[a]] \Rightarrow [[b]] }}
by

% TODO

defns
  Parallels :: '' ::=

defn
  a =>* b :: :: Pars :: 'PS_'
  {{ com multi-step parallel reduction }}
  {{ tex [[a]] \Rightarrow^{\ast} [[b]] }}
by

a => b
------- :: Refl
a =>* b

a => b
b =>* c
------- :: Trans
a =>* c

%% Indistinguishability

defns
  Indist :: '' ::=

defn
  E |- a == b @ l :: :: IEq :: 'I_'
  {{ com indistinguishability }}
  {{ tex [[E]] \vdash [[a]] \equiv^{[[l]]} [[b]] }}
by

% TODO

defn
  E |- a == b @ l l0 :: :: GIEq :: 'GI_'
  {{ com guarded indistinguishability }}
  {{ tex [[E]] \vdash [[a]] \equiv^{[[l]]}_{[[l0]]} [[b]] }}
by

% TODO

%% Definitional equality

defns
  DefEq :: '' ::=

defn
  E |- a == b :: :: Conv :: 'C_'
  {{ com definitional equality }}
  {{ tex [[E]] \vdash [[a]] \equiv [[b]] }}
by

a =>* c0
b =>* c1
E |- c0 == c1 @ l
----------------- :: Conv
E |- a == b

%% Typing and grading judgements

defns
  Typing :: '' ::=

defn
  |- G :: :: Wf :: 'Wf_'
  {{ com well-formedness }}
  {{ tex \vdash [[G]] }}
by

------ :: Nil
|- nil

|- G
G |- A : l (Univ i)
------------------- :: Cons
|- G ++ x : l A

defn
  G |- a : l A :: :: Wt :: 'Wt_'
  {{ com well-typedness }}
  {{ tex [[G]] \vdash [[a]] :^{[[l]]} [[A]] }}
by

|- G
x : l0 A in G
l0 <= l
------------- :: Var
G |- x : l A

G |- A : l Univ i
G ++ x : l0 A |- B : l Univ i
------------------------------- :: Pi
G |- Pi x : l0 A . B : l Univ i

G ++ x : l0 A |- b : l B
G |- Pi x : l0 A . B : l1 Univ i
----------------------------------- :: Abs
G |- \ l0 x . b : l Pi x : l0 A . B

G |- b : l Pi x : l0 A . B
G |- a : l0 A
--------------------------- :: App
G |- b l0 a : l B { a / x }

|- G
-------------------------------- :: Univ
G |- Univ i : l Univ (# i + 1 #)

|- G
-------------------- :: Void
G |- Void : l Univ i

G |- b : l0 Void
G |- A : l1 Univ i
------------------- :: Absurd
G |- absurd b : l A

% TODO: rules for Eq, Refl, J

G |- A : l Univ i
G ++ x : l0 A |- B : l Univ i
-------------------------------- :: Pi
G |- Sig x : l0 A . B : l Univ i

G |- a : l0 A
G |- b : l B { a / x }
G |- Sig x : l0 A . B : l1 Univ i
----------------------------------- :: Pack
G |- (l0 a, b) : l Sig x : l0 A . B

G |- A : l2 Univ i
G ++ x : l0 A |- B : l2 Univ i
G |- a : l1 Sig x : l0 A . B
G ++ x : l0 A ++ y : l1 B |- b : l C { (l0 x, y) / z }
G ++ z : l1 Sig x : l0 A . B |- C : l2 Univ i
------------------------------------------------------ :: Let
G |- let (l0 x , y) = l1 a in b : l C { a / z }

G |- a : l A
G |- B : l0 Univ i
| G | |- A == B
------------------ :: Conv
G |- a : l B

defns
  IOk :: '' ::=

defn
  E |- a : l :: :: Wg :: 'Wg_'
  {{ com well-gradedness }}
  {{ tex [[E]] \vdash [[a]] : [[l]] }}
by

