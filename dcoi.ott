embed
  {{ tex-preamble
    \newcommand{\mt}{ \raisebox{1ex-0.5\height}{$\centerdot$} }
    \newcommand{\const}[1]{ \mathsf{#1} }
  }}

metavar tmvar, x, y, z, f, g, s ::=
  {{ repr-locally-nameless }}
  {{ com variables }}
  {{ lex alphanum }}

metavar m, n ::=
  {{ coq nat }}

indexvar idx ::=
  {{ coq nat }}
  {{ tex \mathit{i} }}

%%%%%%%%%%%%%%%
%%  Grammar  %%
%%%%%%%%%%%%%%%

grammar

luniv, i, j, k :: 'u_' ::=
  {{ com universe levels }}
  {{ coq-universe Type }}
  | n :: :: Level
    {{ tex [[n]] }}
  | i + 1 :: :: Succ
    {{ tex [[i]] + 1 }}
  | max i j :: :: Max
    {{ tex [[i]] \vee [[j]] }}
  | ( i ) :: S :: Parens
    {{ coq ([[i]]) }}
    {{ tex ([[i]]) }}
  | (# i #) :: S :: SecretParens
    {{ coq ([[i]]) }}
    {{ tex [[i]] }}

grade, l {{ tex \ell }} :: 'l_' ::=
  {{ com grades/levels }}
  {{ coq-universe Type }}
  | n :: :: Level
    {{ tex [[n]] }}
  | l0 /\ l1 :: :: Meet
    {{ tex [[l0]] \wedge [[l1]] }}
  | l0 \/ l1 :: :: Join
    {{ tex [[l0]] \vee [[l1]] }}
  | ( l ) :: S :: Parens
    {{ coq ([[l]]) }}
    {{ tex ([[l]]) }}
  | (# l #) :: S :: SecretParens
    {{ coq ([[l]]) }}
    {{ tex [[l]] }}

tm, a, b, c, A, B, C, p :: 'a_' ::=
  {{ com terms and types }}
  {{ coq-universe Type }}
  | x :: :: Var
    {{ com variables }}
    {{ tex [[x]] }}
  | Pi x : l A . B :: :: Pi
    (+ bind x in B +)
    {{ com dependent function type }}
    {{ tex \Pi [[x]] :^{[[l]]} \! [[A]] \mathpunct{.} [[B]] }}
  | \ l x . b :: :: Abs
    (+ bind x in b +)
    {{ com function abstraction }}
    {{ tex \lambda [[x]]^{[[l]]} \mathpunct{.} [[b]]}}
  | b l a :: :: App
    {{ com function application }}
    {{ tex [[b]] \, [[a]]^{[[l]]} }}
  | Univ i :: :: Univ
    {{ com type universe }}
    {{ tex \mathcal{U}_{[[i]]} }} % or perhaps \star_{[[i]]}
  | Void :: :: Empty
    {{ com empty type }}
    {{ tex \bot }}
  | absurd b :: :: Absurd
    {{ com ex falso quodlibet }}
    {{ tex \ottkw{absurd} \, [[b]] }}
  | Unit :: :: Unit
    {{ com unit type }}
    {{ tex \top }}
  | unit :: :: TT
    {{ com unit value }}
    {{ tex \ottkw{tt} }}
  | let unit = l a in b :: :: Seq
    {{ com unit eliminator }}
    {{ tex \ottkw{let} \, \ottkw{tt} = [[a]]^{[[l]]} \, \ottkw{in} \, [[b]] }}
  | a ~ l b :: :: Eq
    {{ com indistinguishability }}
    {{ tex [[a]] =^{[[l]]} \! [[b]] }}
  | refl :: :: Refl
    {{ com reflexivity }}
    {{ tex \ottkw{refl} }}
  | J c l p :: :: J
    {{ com eliminator for equality }}
    {{ tex \ottkw{J} \, [[c]] \, [[p]]^{[[l]]} }}
  | Sig x : l A . B :: :: Sig
    (+ bind x in B +)
    {{ com dependent pair type }}
    {{ tex \Sigma [[x]] :^{[[l]]} \! [[A]] \mathpunct{.} [[B]] }}
  | ( l a , b ) :: :: Pair
    {{ com pair constructor }}
    {{ tex ([[a]]^{[[l]]}, [[b]]) }}
  | let ( l0 x , y ) = l a in b :: :: Let
    (+ bind x union y in b +)
    {{ com weak pair projection }}
    {{ tex \ottkw{let} \, ([[x]]^{[[l0]]}, [[y]]) = [[a]]^{[[l]]} \mathrel{ \ottkw{in} } [[b]] }}
  | T l A :: S :: T
    {{ com boxed type }}
    {{ coq }}
    {{ tex \ottkw{T}^{[[l]]} \, [[A]] }}
  | box l a :: S :: box
    {{ com box }}
    {{ coq }}
    {{ tex \ottkw{box}^{[[l]]} \, [[a]] }}
  | unbox l a :: S :: unbox
    {{ com unbox }}
    {{ coq }}
    {{ tex \ottkw{unbox}^{[[l]]} [[a]] }}
  | Nat :: :: Nat
    {{ com naturals }}
    {{ tex \ottkw{Nat} }}
  | zero :: :: Zero
    {{ com zero }}
    {{ tex \ottkw{zero} }}
  | succ a :: :: Succ
    {{ com successor }}
    {{ tex \ottkw{succ} \, [[a]] }}
  | ind l a b0 ( \ x y . b1 ) :: :: Ind
    (+ bind x union y in b1 +)
    {{ com induction principle for naturals }}
    {{ tex \ottkw{ind}^{[[l]]} \, [[a]] \, [[b0]] \, (\lambda [[x]] \, [[y]] \mathpunct{.} [[b1]]) }}
  | ( a ) :: S :: Parens
    {{ com parentheses }}
    {{ coq ([[a]]) }}
    {{ tex ([[a]]) }}
  | (# a #) :: S :: SecretParens
    {{ com invisible parentheses }}
    {{ coq ([[a]]) }}
    {{ tex [[a]] }}
  | a { b / x } :: S :: Subst
    {{ com single substitution }}
    {{ coq (open_tm_wrt_tm [[x]] [[a]] [[b]]) }}
    {{ tex [[a]] \lbrack [[b]] / [[x]] \rbrack }}
  | a { b / x , c / y } :: S :: Subst2
    {{ com double substitution }}
    {{ coq (open_tm_wrt_tm [[y]] (open_tm_wrt_tm [[x]] [[a]] [[b]]) [[c]]) }}
    {{ tex [[a]] \lbrack [[b]] / [[x]], [[c]] / [[y]] \rbrack }}
  | dummy :: ::  Dummy
    {{ tex \ottkw{d} }}

context, G {{ tex \Gamma }}, D {{ tex \Delta }} :: 'ctx_' ::=
  {{ com contexts }}
  {{ coq list (atom * (grade * tm)) }}
  {{ coq-universe Type }}
  | nil :: S :: Nil
    {{ com empty context }}
    {{ coq nil }}
    {{ tex \mt }}
  | x : l A :: S :: One
    {{ com singleton context }}
    {{ coq ([[x]], ([[l]], [[A]])) }}
    {{ tex [[x]] :^{[[l]]} \! [[A]] }}
  | G ++ G' :: S :: Append
    {{ com appending two contexts }}
    {{ coq [[G]] ++ [[G']] }}
    {{ tex [[G]], [[G']] }}
  | ( G ) :: S :: Parens
    {{ com parentheses }}
    {{ coq ([[G]]) }}
    {{ tex ([[G]]) }}
  | (# G #) :: S :: SecretParens
    {{ com invisible parentheses }}
    {{ coq ([[G]]) }}
    {{ tex [[G]] }}

econtext, E {{ tex \Xi }} , F {{ tex \Phi }} :: 'ectx_' ::=
  {{ com erased contexts }}
  {{ coq list ( atom * grade ) }}
  {{ coq-universe Type }}
  | nil :: S :: Empty
    {{ com empty context }}
    {{ coq nil }}
    {{ tex \mt }}
  | x : l :: S :: One
    {{ com singleton context }}
    {{ coq ([[x]], [[l]]) }}
    {{ tex [[x]] : [[l]] }}
  | E ++ E' :: S :: Append
    {{ com appending two contexts }}
    {{ coq [[E]] ++ [[E']] }}
    {{ tex [[E]], [[E']] }}
  | | G | :: S :: Erase
    {{ com erased contexts }}
    {{ coq c2e [[G]] }}
    {{ tex \lvert [[G]] \rvert }}
  | ( E ) :: S :: Parens
    {{ com parentheses }}
    {{ coq ([[E]]) }}
    {{ tex ([[E]]) }}
  | (# E #) :: S :: SecretParens
    {{ com invisible parentheses }}
    {{ coq ([[E]]) }}
    {{ tex [[E]] }}

substitutions
  single tm x :: subst
  multiple tm x :: substs

freevars
  tm x :: fv

%%%%%%%%%%%%%%%%
%%  Formulas  %%
%%%%%%%%%%%%%%%%

grammar

formula :: 'formula_' ::=
  | judgement :: :: judgement % DON'T DELETE THIS
  | formula1 .. formulaidx :: :: dots % DON'T DELETE THIS
  | x : l A in G :: :: inG
    {{ coq binds [[x]] ([[l]], [[A]]) [[G]] }}
    {{ tex [[x]] :^{[[l]]} \! [[A]] \in [[G]] }}
  | x : l in E :: :: inE
    {{ coq binds [[x]] [[l]] [[E]] }}
    {{ tex [[x]] : [[l]] \in [[E]] }}
  | x notin G :: :: notInG
    {{ coq ~ AtomSetImpl.In [[x]] (dom [[G]]) }}
    {{ tex [[x]] \notin [[G]] }}
  | x notin E :: :: notInE
    {{ coq ~ AtomSetImpl.In [[x]] (dom [[E]]) }}
    {{ tex [[x]] \notin [[E]] }}
  | i <= j :: :: uleq
    {{ coq [[i]] <= [[j]] }}
    {{ tex [[i]] \leq [[j]] }}
  | l1 <= l2 :: :: leq
    {{ coq [[l1]] <= [[l2]] }}
    {{ tex [[l1]] \leq [[l2]] }}
  | not ( l1 <= l2 ) :: S :: not
    {{ coq not ([[l1]] <= [[l2]]) }}
    {{ tex [[l1]] \nleq [[l2]] }}
  | ( formula ) :: S :: Parens
    {{ com parentheses }}
    {{ coq ([[formula]]) }}
    {{ tex ([[formula]]) }}
  | (# formula #) :: S :: SecretParens
    {{ com invisible parentheses }}
    {{ coq ([[formula]]) }}
    {{ tex [[formula]] }}

