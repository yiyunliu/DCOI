%%  Judgements  %%
%%%%%%%%%%%%%%%%%%

%%  Parallel reduction

defns
  Parallel :: '' ::=

defn
  a => b :: :: Par :: 'P_'
  {{ com parallel reduction }}
  {{ tex [[a]] \Rightarrow [[b]] }}
by

% beta rules

a0 => a1
b0 => b1
------------------------------------ :: AppAbs
(\ l0 x . b0) l0 a0 => b1 { a1 / x }

b0 => b1
----------------------------- :: SeqTT
let unit = l unit in b0 => b1

c0 => c1
----------------- :: JRefl
J c0 l refl => c1

a0 => a1
b0 => b1
c0 => c1
------------------------------------------------------------- :: LetPair
let (l0 x, y) = l (l0 a0, b0) in c0 => c1 { a1 / x , b1 / y }

b0 => b1
------------------------------ :: IndZero
ind l zero b0 (\x y. c0) => b1

a0 => a1
b0 => b1
c0 => c1
--------------------------------------------------------------------------- :: IndSucc
ind l (succ a0) b0 (\x y. c0) => c1 { a1 / x , ind l a1 b1 (\x y. c1) / y }

% congruence rules

------ :: Var
x => x

A0 => A1
B0 => B1
-------------------------------------- :: Pi
Pi x : l0 A0 . B0 => Pi x : l0 A1 . B1

b0 => b1
-------------------------- :: Abs
\ l0 x . b0 => \ l0 x . b1

b0 => b1
a0 => a1
-------------------- :: App
b0 l0 a0 => b1 l0 a1

---------------- :: Univ
Univ i => Univ i

------------ :: Empty
Void => Void

b0 => b1
---------------------- :: Absurd
absurd b0 => absurd b1

------------ :: Unit
Unit => Unit

------------ :: TT
unit => unit

a0 => a1
b0 => b1
---------------------------------------------- :: Seq
let unit = l a0 in b0 => let unit = l a1 in b1

a0 => a1
b0 => b1
------------------------ :: Eq
a0 ~ l0 b0 => a1 ~ l0 b1

------------ :: Refl
refl => refl

p0 => p1
c0 => c1
---------------------- :: J
J c0 l p0 => J c1 l p1

A0 => A1
B0 => B1
---------------------------------------- :: Sig
Sig x : l0 A0 . B0 => Sig x : l0 A1 . B1

a0 => a1
b0 => b1
-------------------------- :: Pair
(l0 a0, b0) => (l0 a1, b1)

a0 => a1
b0 => b1
-------------------------------------------------------- :: Let
let (l0 x, y) = l a0 in b0 => let (l0 x, y) = l a1 in b1

---------- :: Nat
Nat => Nat

------------ :: Zero
zero => zero

a0 => a1
------------------ :: Succ
succ a0 => succ a1

a0 => a1
b0 => b1
c0 => c1
------------------------------------------------ :: Ind
ind l a0 b0 (\x y. c0) => ind l a1 b1 (\x y. c1)

---------------------- :: D
dummy => dummy

defns
  Parallels :: '' ::=

defn
  a =>* b :: :: Pars :: 'Ps_'
  {{ com multi-step parallel reduction }}
  {{ tex [[a]] \Rightarrow^{\ast} [[b]] }}
by

a => b
------- :: Refl
a =>* b

a => b
b =>* c
------- :: Trans
a =>* c

%% Indistinguishability

defns
  Indist :: '' ::=

defn
  E |- a == b @ l :: :: IEq :: 'I_'
  {{ com indistinguishability }}
  {{ tex [[E]] \vdash [[a]] \equiv^{[[l]]} [[b]] }}
by

x : l0 in E
l0 <= l
--------------- :: Var
E |- x == x @ l

E |- A0 == A1 @ l
E ++ x : l0 |- B0 == B1 @ l
--------------------------------------------- :: Pi
E |- Pi x : l0 A . B == Pi x : l0 A1 . B1 @ l

E ++ x : l0 |- b0 == b1 @ l
----------------------------------- :: Abs
E |- \ l0 x . b0 == \ l0 x . b1 @ l

E |- b0 == b1 @ l
E |- a0 == a1 @ l l0
----------------------------- :: App
E |- b0 l0 a0 == b1 l0 a1 @ l

------------------------- :: Univ
E |- Univ i == Univ i @ l

--------------------- :: Empty
E |- Void == Void @ l

------------------------------- :: Absurd
E |- absurd b0 == absurd b1 @ l

--------------------- :: Unit
E |- Unit == Unit @ l

--------------------- :: TT
E |- unit == unit @ l

E |- a0 == a1 @ l
E |- b0 == b1 @ l
l1 <= l
--------------------------------------------------------- :: Seq
E |- let unit = l1 a0 in b0 == let unit = l1 a1 in b1 @ l

E |- a0 == a1 @ l
E |- b0 == b1 @ l
l0 <= l
--------------------------------- :: Eq
E |- a0 ~ l0 b0 == a1 ~ l0 b1 @ l

--------------------- :: Refl
E |- refl == refl @ l

E |- p0 == p1 @ l
E |- c0 == c1 @ l
l2 <= l
--------------------------------- :: J
E |- J c0 l2 p0 == J c1 l2 p1 @ l

E |- A0 == A1 @ l
E ++ x : l0 |- B0 == B1 @ l
----------------------------------------------- :: Sig
E |- Sig x : l0 A0 . B0 == Sig x : l0 A1 . B1 @ l

E |- a0 == a1 @ l l0
E |- b0 == b1 @ l
----------------------------------- :: Pair
E |- (l0 a0, b0) == (l0 a1, b1) @ l

E |- a0 == a1 @ l
(# E ++ x : l0 #) ++ y : l1 |- b0 == b1 @ l
l1 <= l
------------------------------------------------------------------- :: Let
E |- let (l0 x, y) = l1 a0 in b0 == let (l0 x, y) = l1 a1 in b1 @ l

------------------- :: Nat
E |- Nat == Nat @ l

--------------------- :: Zero
E |- zero == zero @ l

E |- a0 == a1 @ l
--------------------------- :: Succ
E |- succ a0 == succ a1 @ l

E |- a0 == a1 @ l
E |- b0 == b1 @ l
(# E ++ x : l0 #) ++ y : l0 |- c0 == c1 @ l
l0 <= l
----------------------------------------------------------- :: Ind
E |- ind l0 a0 b0 (\x y. c0) == ind l0 a1 b1 (\x y. c1) @ l

---------------------- :: D
E |- dummy == dummy @ l

defn
  E |- a == b @ l l0 :: :: GIEq :: 'GI_'
  {{ com guarded indistinguishability }}
  {{ tex [[E]] \vdash [[a]] \equiv^{[[l]]}_{[[l0]]} [[b]] }}
by

E |- a == b @ l
l0 <= l
------------------ :: Dist
E |- a == b @ l l0

not (l0 <= l)
------------------ :: Indist
E |- a == b @ l l0

defns
  DefEq :: '' ::=

defn
  E |- a == b :: :: DefEq :: 'E_'
  {{ com definitional equality }}
  {{ tex [[E]] \vdash [[a]] \equiv [[b]] }}
by

a =>* c0
b =>* c1
E |- c0 == c1 @ l
----------------- :: Conv
E |- a == b

defns
  DefEqL :: '' ::=

defn
  E |- a <=> b @ l :: :: DefEqL :: 'EL_'
  {{ com definitional equality at a level }}
  {{ tex [[E]] \vdash [[a]] \Leftrightarrow^{[[l]]} [[b]] }}
by

a =>* c0
b =>* c1
E |- c0 == c1 @ l
----------------- :: Conv
E |- a <=> b @ l

%% Typing and grading judgements

defns
  Typing :: '' ::=

defn
  |- G :: :: Wf :: 'Wf_'
  {{ com well-formedness }}
  {{ tex \vdash [[G]] }}
by

------ :: Nil
|- nil

|- G
G |- A : Univ i
---------------- :: Cons
|- G ++ x : l A

defn
  G |- a : A :: :: Wtg :: 'Wtg_'
  {{ com ungraded well-typedness }}
  {{ tex [[G]] \vdash [[a]] : [[A]] }}
by

G |- a : l A
------------ :: Grade
G |- a : A

defn
  G |- a : l A :: :: Wt :: 'Wt_'
  {{ com well-typedness }}
  {{ tex [[G]] \vdash [[a]] :^{[[l]]} [[A]] }}
by

|- G
x : l0 A in G
l0 <= l
------------- :: Var
G |- x : l A

G |- A : l Univ i
G ++ x : l0 A |- B : l Univ j
------------------------------------------- :: Pi
G |- Pi x : l0 A . B : l Univ (# max i j #)

G ++ x : l0 A |- b : l B
G |- Pi x : l0 A . B : Univ i
----------------------------------- :: Abs
G |- \ l0 x . b : l Pi x : l0 A . B

G |- b : l Pi x : l0 A . B
G |- a : l0 A
--------------------------- :: App
G |- b l0 a : l B { a / x }

|- G
-------------------------------- :: Univ
G |- Univ i : l Univ (# i + 1 #)

|- G
-------------------- :: Empty
G |- Void : l Univ i

G |- b : Void
G |- A : Univ i
------------------- :: Absurd
G |- absurd b : l A

|- G
-------------------- :: Unit
G |- Unit : l Univ i

|- G
---------------- :: TT
G |- unit : l Unit

G |- a : l1 Unit
G |- b : l C { unit / x }
G ++ x : l1 Unit |- C : Univ i
l1 <= l
----------------------------------------- :: Seq
G |- let unit = l1 a in b : l C { a / x }

G |- a : l0 A
G |- b : l0 A
l0 <= l
------------------------ :: Eq
G |- a ~ l0 b : l Univ j

G |- a : l0 A
---------------------- :: Refl
G |- refl : l a ~ l0 a

G |- a : l1 A
G |- b : l1 A
G |- A : Univ i
G |- p : l2 a ~ l0 b
(# G ++ x : l1 A #) ++ y : l2 a ~ l0 x |- C : l0 Univ j
G |- c : l C { a / x , refl / y }
l1 <= l0
l2 <= l
------------------------------------------------------- :: J
G |- J c l2 p : l C { b / x , p / y }

G |- A : l Univ i
G ++ x : l0 A |- B : l Univ j
-------------------------------------------- :: Sig
G |- Sig x : l0 A . B : l Univ (# max i j #)

G |- a : l0 A
G |- b : l B { a / x }
G |- Sig x : l0 A . B : Univ i
----------------------------------- :: Pair
G |- (l0 a, b) : l Sig x : l0 A . B

G |- A : Univ i
G ++ x : l0 A |- B : Univ j
G |- a : l1 Sig x : l0 A . B
(# G ++ x : l0 A #) ++ y : l1 B |- b : l C { (l0 x, y) / z }
G ++ z : l1 Sig x : l0 A . B |- C : Univ k
l1 <= l
------------------------------------------------------------ :: Let
G |- let (l0 x, y) = l1 a in b : l C { a / z }

|- G
------------------- :: Nat
G |- Nat : l Univ i

|- G
----------------- :: Zero
G |- zero : l Nat

G |- a : l Nat
------------------- :: Succ
G |- succ a : l Nat

G ++ z : l0 Nat |- A : l1 Univ i
G |- a : l0 Nat
G |- b0 : l0 A {zero / z}
(# G ++ x : l0 Nat #) ++ y : l0 A {x / z} |- b1 : l0 A {succ x / z}
l0 <= l
------------------------------------------------------------------- :: Ind
G |- ind l0 a b0 (\x y. b1) : l A {a / z}

G |- a : l A
G |- B : Univ i
| G | |- A == B
------------------ :: Conv
G |- a : l B

