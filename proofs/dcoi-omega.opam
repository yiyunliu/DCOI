opam-version: "2.0"
synopsis: "Mechanized proofs for DCOI Omega" # One-line description

maintainer: "Anonymous"

license: "MIT"

depends: [
  "coq" {>= "8.18" }
  "coq-equations" {>= "1.3"}
  "coq-hammer-tactics" {>= "1.3.2"}
  "coq-stdpp" {>= "1.9.0"}
]

build: [
  [make "-j%{jobs}%"]
]
install: [
  [make "install"]
]
