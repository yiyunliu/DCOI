grammar

indent, amps :: 'ind_' ::=
  {{ com hack for LaTeX indentation }}
  | ^ :: :: None
    {{ tex }}
  | & :: :: One
    {{ tex & }}
  | amps & :: :: Many
    {{ tex [[amps]] & }}

luniv :: 'u_' ::=
  {{ com concrete universe levels }}
  | 0 :: :: Zero
    {{ tex 0 }}

grade :: 'l_' ::=
  {{ com concrete grades }}
  | L :: :: Low
    {{ tex \const{L} }}
  | H :: :: High
    {{ tex \const{H} }}

pat :: 'p_' ::=
  {{ com case branch patterns }}
  | x :: :: Head
    {{ tex \const{[[x]]} }}
  | pat x :: :: Arg
    {{ tex [[pat]] \, [[x]] }}

branch :: 'b_' ::=
  {{ com case branch }}
  | pat => b :: :: Branch
    {{ tex [[pat]] \Rightarrow [[b]] }}

branches, bs :: 'bs_' ::=
  {{ com case branches }}
  | amps branch :: :: One
    {{ tex \\ [[amps]] \mid [[branch]] }}
  | bs ++ amps branch :: :: Many
    {{ tex [[bs]] \\ [[amps]] \mid [[branch]] }}

subst, rho {{ tex \rho }} :: 's_' ::=
  {{ com simultaneous substitution }}
  | nil :: :: Empty
    {{ com identity substitution }}
    {{ tex \mt }}
  | { a / x } :: :: Single
    {{ com single subsitution }}
    {{ tex [[a]] / [[x]] }}
  | rho ++ { a / x } :: :: Cons
    {{ com substitution extension }}
    {{ tex [[rho]], [[a]] / [[x]] }}
  | ( rho ) :: S :: Parens
    {{ com parentheses }}
    {{ tex ([[rho]]) }}
  | (# rho #) :: S :: SecretParens
    {{ com invisible parentheses }}
    {{ tex [[rho]] }}

tm :: 'a_' ::=
  | phantom :: S :: Phantom
    {{ com invisible placeholder for typesetting }}
    {{ tex }}
  | poltergeist :: S :: Poltergeist
    {{ com visible placeholder for typesetting }}
    {{ tex \cdot }}
  | ! x :: S :: Const
    {{ com constant }}
    {{ coq [[x]] }}
    {{ tex \const{[[x]]} }}
  | a { rho } :: S :: Substs
    {{ com simultaneous substitution }}
    {{ tex [[a]] \lbrack [[rho]] \rbrack }}
  | rho ( x ) :: S :: Substituted
    {{ com term substituted for x }}
    {{ tex [[rho]]([[x]]) }}
  | Unit :: S :: Unit
    {{ com unit type }}
    {{ tex \top }}
  | l A -> B :: S :: Arrow
    {{ com nondependent function type }}
    {{ tex [[A]] \overset{[[l]]}{\rightarrow} [[B]] }}
  | a ~ l b :: S :: EqS
    {{ com indistinguishability (no type annotation) }}
    {{ coq a_Eq [[a]] [[l]] [[b]] _ }}
    {{ tex [[a]] \sim^{[[l]]} \! [[b]] }}
  | J c l p :: S :: JAnnot
    {{ com eliminator for equality (with level annotation) }}
    {{ coq a_J [[c]] [[p]] }}
    {{ tex \ottkw{[[J]]} \, [[c]] \, [[p]]^{[[l]]} }}
  | let ( l0 x , y ) = l1 a in b :: :: LetAnnot
    (+ bind x union y in b +)
    {{ com weak pair projection (with level annotation) }}
    {{ tex \ottkw{let} \, ([[x]]^{[[l0]]}, [[y]]) = [[a]]^{[[l1]]} \mathrel{ \ottkw{in} } [[b]] }}
  | case a return c of bs :: S :: Case
    {{ com case expressions }}
    {{ tex \ottkw{case} \, [[a]] \, \ottkw{return} \, [[c]] \, \ottkw{of} \, [[bs]] }}

toplevel :: 'tl_' ::=
  {{ com top-level statements }}
  | x amps : a @ l :: :: Decl
    {{ com declaration }}
    {{ tex \const{[[x]]} [[amps]] :^{[[l]]} [[a]] }}
  | x amps := a :: :: Defn
    {{ com definition }}
    {{ tex \const{[[x]]} [[amps]] \coloneqq [[a]] }}

formula :: 'formula_' ::=
  | l1 < l2 :: :: lt
    {{ coq [[l1]] < [[l2]] }}
    {{ tex [[l1]] < [[l2]] }}

%%%%%%%%%%%%%%%%%%%%%%
%% Admissible rules %%
%%%%%%%%%%%%%%%%%%%%%%

defns
  Parallel :: '' ::=

defn
  a => b :: :: Par :: 'P_'
  {{ com parallel reduction }}
  {{ tex [[a]] \Rightarrow [[b]] }}
by

defns
  Parallels :: '' ::=

defn
  a =>* b :: :: Pars :: 'Ps_'
  {{ com multi-step parallel reduction }}
  {{ tex [[a]] \Rightarrow^{\ast} [[b]] }}
by

a0 =>* a1
b0 =>* b1
--------------------------- :: subst
b0 {a0 / x} =>* b1 {a1 / x}

defns
  Indist :: '' ::=

defn
  E |- a == b @ l :: :: IEq :: 'I_'
  {{ com indistinguishability }}
  {{ tex [[E]] \vdash [[a]] \equiv^{[[l]]} [[b]] }}
by

E |- a == b @ l0
E |- a == c @ l1
---------------- :: downgrade
E |- a == b @ l0 /\ l1

E |- a : l0
l0 <= l1
---------------- :: refl
E |- a == a @ l1

E |- a == b @ l
--------------- :: sym
E |- b == a @ l

E |- a == b @ l0
E |- b == c @ l1
---------------------- :: trans
E |- a == c @ l0 /\ l1

F |- b0 == b1 @ l
E |- rho0 == rho1 : F @ l
----------------------------------- :: morph
E |- b0 { rho0 } == b1 { rho1 } @ l

E ++ x : l0 |- b0 == b1 @ l
E |- a : l0
------------------------------------- :: subst
E |- b0 { a / x } == b1 { a / x } @ l

defn
  E |- a == b @ l l0 :: :: GIEq :: 'GI_'
  {{ com guarded indistinguishability }}
  {{ tex [[E]] \vdash [[a]] \equiv^{[[l]]}_{[[l0]]} [[b]] }}
by

defns
  DefEq :: '' ::=

defn
  E |- a == b :: :: DefEq :: 'E_'
  {{ com definitional equality }}
  {{ tex [[E]] \vdash [[a]] \equiv [[b]] }}
by

E |- a0 == b0
a0 => a1
b0 => b1
------------- :: par
E |- a1 == b1

G |- a : l A
--------------- :: refl
| G | |- a == a

E |- a == b
----------- :: sym
E |- b == a

E |- a == b
E |- b == c
----------- :: trans
E |- a == c
  
E ++ x : l |- b0 == b1
E |- a : l
--------------------------------- :: subst
E |- b0 { a / x } == b1 { a / x }

defns
  Typing :: '' ::=

defn
  |- G :: :: Wf :: 'Wf_'
  {{ com well-formedness }}
  {{ tex \vdash [[G]] }}
by

defn
  G |- a : A :: :: Wtg :: 'Wtg_'
  {{ com ungraded well-typedness }}
  {{ tex [[G]] \vdash [[a]] : [[A]] }}
by

defn
  G |- a : l A :: :: Wt :: 'Wt_'
  {{ com well-typedness }}
  {{ tex [[G]] \vdash [[a]] :^{[[l]]} [[A]] }}
by

G |- a : l0 A
l0 <= l1
------------- :: sub
G |- a : l1 A

G |- a : l0 A
G ++ x : l0 A |- b : l B
-------------------------------- :: subst
G |- b { a / x } : l B { a / x }

G |- a : l0 A
| G | |- a : l1
------------------- :: downgrade
G |- a : l0 /\ l1 A

defns
  IOk :: '' ::=

defn
  E |- a : l :: :: Wg :: 'Wg_'
  {{ com well-gradedness }}
  {{ tex [[E]] \vdash [[a]] : [[l]] }}
by

G |- a : l A
-------------- :: Wt
| G | |- a : l

E |- a : l0
l0 <= l1
----------- :: sub
E |- a : l1

F |- b : l
E |- rho : F
------------------ :: morph
E |- b { rho } : l

E ++ x : l0 |- b : l
E |- a : l0
-------------------- :: subst
E |- b { a / x } : l

defns
  IOk_Subst :: '' ::=

defn
  F |- rho : E :: :: Sg :: 'Sg_'
  {{ com substitution well-gradedness }}
  {{ tex [[F]] \vdash [[rho]] : [[E]] }}
by

------------ :: nil
E |- nil : E

F |- rho : E
F |- a : l
-------------------------------------- :: cons
F |- (rho ++ { a / x }) : (E ++ x : l)

F |- rho : E
--------------------- :: weak
F ++ x : l |- rho : E

defns
  IEq_Subst :: '' ::=

defn
  F |- rho0 == rho1 : E @ l :: :: SI :: 'SI_'
  {{ com substitution indisinguishability }}
  {{ tex [[F]] \vdash [[rho0]] \equiv^{[[l]]} [[rho1]] : [[E]] }}
by

----------------------- :: nil
E |- nil == nil : E @ l

F |- rho0 == rho1 : E @ l
F |- a0 == a1 @ l l0
--------------------------------------------------------------------- :: cons
F |- (rho0 ++ { a0 / x }) == (rho1 ++ { a1 / x }) : (E ++ x : l0) @ l

F |- rho0 == rho1 : E @ l
----------------------------------- :: weak
F ++ x : l0 |- rho0 == rho1 : E @ l