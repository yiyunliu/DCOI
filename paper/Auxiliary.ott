grammar

grade, psi {{ tex \ell }} , phi {{ tex k }} :: 'q_' ::= {{ phantom }}
  | High :: M :: high {{ coq }} {{ tex \texttt{H} }}
  | Low  :: M :: Low  {{ coq }} {{ tex \texttt{L} }}
  | R    :: M :: R    {{ coq }} {{ tex \texttt{L} }}
  | S    :: M :: C    {{ coq }} {{ tex \texttt{S} }}
  | I    :: M :: I    {{ coq }} {{ tex \texttt{H} }}
  | bot  :: M :: bot  {{ coq }} {{ tex \bot }}
  | top  :: M :: top  {{ coq }} {{ tex \top }}

tm, a , b , c , A , B , C , p , u , v , t :: 'a_' ::= {{ com terms and types }}
                                                      {{ coq-universe Type }}
  | Nat        :: M :: Nat     {{ coq }} {{ tex \textsf{Nat} }}
  | 0          :: M :: Zero    {{ coq }}
  | a ~ b : A  :: M :: Eq      {{ coq }} {{ tex [[a]] \sim [[b]] \in [[A]] }}
  | a + b      :: M :: Plus    {{ coq }}
  | A psi -> B :: M :: DArrow  {{ coq }} {{ tex [[A]]^{[[psi]]} \mathrel{\rightarrow} [[B]] }}
  | hole       :: M :: Hole    {{ coq }} {{ tex \Box }}
  | Eq A a b   :: M :: EqInd   {{ coq }} {{ tex \textsf{Eq}\;[[A]]\;[[a]]\;[[b]] }}
  | Refl       :: M :: ReflInd {{ coq }} {{ tex \textsf{Refl} }}
  | case a return \ y . B of b => c :: M :: Case {{ coq }}
    {{ tex \ottkw{case}\;[[a]]\;\ottkw{return}\;\lambda[[y]]\mathpunct{.}[[B]]\;\ottkw{of}\;[[b]]\mathrel{\Rightarrow}[[c]] }}

defns
  JGDefEq :: '' ::=

defn
  P |- psi a == b ::  :: GDefEq :: 'GE_' {{ com GDefEq }}
  {{ tex [[P]] \vdash [[a]] \equiv^{[[psi]]} [[b]] }}
by

P |- psi0 a0 == a1
P |- psi0 b0 == b1
-------------------------------- :: CEqWrong
P |- psi psi0 a0 ~ b0 : A0 == psi0 a1 ~ b1 : A1

defns
  JTyping :: '' ::=

defn
  W |- psi a : A ::  :: Typing :: 'T_' {{ com Typing }}
{{ tex [[W]] \vdash [[a]]:^{[[psi]]} [[A]] }}
by

%% morally, psi will either be RTime or CTime in this judgement. It should never be Top.
%% If it needs to be top, it should be squashed instead.

W |- psi a : A
W |- psi0 B : type s
|W| |- psi0 A == B
-------------------- :: ConvAlt
W |- psi a : B

W ++ x : psi \/ psi0 A |- psi b : B
W |- psi1 (Pi x:psi \/ psi0 A. B) : type s
-------------------------------------------- :: AbsJoin
W |- psi \ psi0 x : A . b : Pi x :psi0 A . B

W |- psi b : Pi x :psi0 A . B
W |- psi \/ psi0 a : A
----------------------------- :: AppJoin
W |- psi b psi0 a : B {a/x}

W |- psi3 c : Eq A a b
W ++ y : psi1 A |- psi0 B : type s
W |- psi4 b : B {a/y}
---------------------------------------------------- :: CaseEq
W |- psi4 case c return \y. B of Refl => b : B {b/y}